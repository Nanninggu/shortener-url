<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.hlink.urlshortener.mapper.UserMapper">

    <resultMap id="UserResultMap" type="com.hlink.urlshortener.model.User">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="email" column="email"/>
        <result property="passwordHash" column="password_hash"/>
        <result property="role" column="role"/>
        <result property="planType" column="plan_type"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.hlink.urlshortener.model.User" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO users (username, email, password_hash, role, plan_type, created_at, updated_at)
        VALUES (#{username}, #{email}, #{passwordHash}, #{role}, #{planType}, #{createdAt}, #{updatedAt})
    </insert>

    <select id="findById" resultMap="UserResultMap">
        SELECT * FROM users WHERE id = #{id}
    </select>

    <select id="findByUsername" resultMap="UserResultMap">
        SELECT * FROM users WHERE username = #{username}
    </select>

    <select id="findByEmail" resultMap="UserResultMap">
        SELECT * FROM users WHERE email = #{email}
    </select>

    <select id="findAll" resultMap="UserResultMap">
        SELECT * FROM users ORDER BY created_at DESC
    </select>

    <update id="update" parameterType="com.hlink.urlshortener.model.User">
        UPDATE users
        SET username = #{username},
            email = #{email},
            password_hash = #{passwordHash},
            role = #{role},
            plan_type = #{planType},
            updated_at = #{updatedAt}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM users WHERE id = #{id}
    </delete>

</mapper>

